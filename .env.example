# Local development defaults — copy from root .env.example and adjust.
NODE_ENV=development
PORT=3000
API_PREFIX=v1
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

DATABASE_URL=postgresql://clox:clox@localhost:5432/clox_prelaunch?schema=public

# postgresql://clox:clox@localhost:5432/clox_prelaunch?schema=public
# postgresql://postgres:clox12309clox@db.hnklabzudoagmwkdiigy.supabase.co:5432/postgres
JWT_ACCESS_SECRET=dev-access-secret-change-me-32chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-32chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

OTP_TTL_MINUTES=10
OTP_LENGTH=6

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CLOX <noreply@clox.com.au>"
INVEST_NOTIFY_EMAIL=


SEED_SUPER_ADMIN_EMAIL=cloxadmin@yopmail.com
SEED_SUPER_ADMIN_NAME=CLOX Super Admin
SEED_STATE_MASTER_EMAIL=state.vic@yopmail.com
SEED_LOCAL_BDE_EMAIL=local.mel@yopmail.com
SEED_SENDER_EMAIL=sender.qa@yopmail.com
SEED_CARRIER_EMAIL=carrier.qa@yopmail.com
SEED_DRIVER_EMAIL=driver.qa@yopmail.com

# Stripe (M3–M7) — leave STRIPE_SECRET_KEY empty for mock mode
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_MOCK=true

# Dev only — never enable in production (leaks OTP in API responses)
EXPOSE_OTP_IN_RESPONSE=false

# M9 geofence
# GEOFENCE_RADIUS_METERS=200
# GEOFENCE_FREE_WAIT_SECONDS=30

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=10
